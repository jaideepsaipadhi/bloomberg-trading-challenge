# Copy to .env and fill in. All values are OPTIONAL — defaults work for a
# console dry-run with no credentials.

# ---- Portfolio ----
TOTAL_CAPITAL=1000000
NOTIONAL_PER_TRADE=100000

# ---- Strategy (override only if you know why) ----
# Momentum "sweet spot" (tuned defaults shown):
# ROC_LOOKBACK=10
# ROC_MIN=2.0
# RSI_MIN=55
# RSI_MAX=70
# VOLUME_RATIO_MIN=1.2
# EMA_FAST=8
# EMA_MID=21
# EMA_SLOW=50
# STOP_ATR_MULT=1.5
# MAX_SIGNALS=10
# Exit style: trend (default, ride winners) or swing (fixed target):
# EXIT_MODE=trend
# TRAIL_ATR_MULT=3.0
# MAX_TREND_DAYS=30
# USE_EMA_TREND_EXIT=true
# swing-mode only:
# REWARD_RISK_RATIO=1.5
# MAX_HOLD_DAYS=2

# ---- Cross-sectional momentum alpha (trading-bot momentum) ----
# MOM_LOOKBACK=252
# MOM_SKIP=21
# MOM_REBALANCE_DAYS=21
# MOM_TOP_K=20
# MOM_WEIGHT=invvol        # invvol (default, smoother) | equal
# MOM_WEIGHT_VOL_WINDOW=63
# MOM_VOL_WINDOW=0         # >0 risk-adjusts the selection score (off by default)

# ---- Optional win-rate filters (default off). See README "Tuning". ----
# Only go long when the benchmark is above its EMA (market regime):
# USE_REGIME_FILTER=false
# BENCHMARK_SYMBOL=SPY
# REGIME_EMA=100
# Require a real trend, skip chop (ADX):
# USE_ADX_FILTER=false
# ADX_MIN=20
# Require the slow EMA itself to be rising:
# USE_SLOPE_FILTER=false
# Buy near the fast EMA (pullback) instead of chasing extended bars:
# USE_PULLBACK_ENTRY=false
# PULLBACK_MAX_EXTENSION=1.0

# ---- WhatsApp delivery ----
# provider: console (default) | twilio
WHATSAPP_PROVIDER=console

# Twilio WhatsApp (only needed if WHATSAPP_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Comma-separated opted-in numbers (broadcast list; NOT a group id):
# WHATSAPP_RECIPIENTS=whatsapp:+1555XXXXXXX,whatsapp:+1444XXXXXXX
